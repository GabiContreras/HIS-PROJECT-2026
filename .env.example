# Copiar a apps/api/.env y completar con valores propios.
# No subir nunca apps/api/.env al repositorio.
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PORT=3000
# En Postgres local sin TLS usar false; para Supabase mantener true.
DATABASE_SSL=true
FRONTEND_ORIGINS=http://localhost:5173
# 48 bytes aleatorios; minimo 32 bytes. Mantener privado y estable.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# JWT_EXPIRES_IN acepta segundos o sufijo s/m/h/d; access JWT max. 15m.
JWT_EXPIRES_IN=15m
# Segundos; refresh token max. 30 dias.
REFRESH_TOKEN_TTL_SECONDS=604800
# Solo se usan al ejecutar una unica vez iam:bootstrap-superadmin.
SUPERADMIN_NOMBRE=Super
SUPERADMIN_APELLIDO=Administrador
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
