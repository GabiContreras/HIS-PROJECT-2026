+      pacientePesos: 15_000,
+      terceroPesos: 0,
+    });
+  });
+
+  it('el reparto siempre suma el valor base', () => {
+    for (const tipo of Object.values(CoverageType)) {
+      const { pacientePesos, terceroPesos } = coverageStrategyFor(tipo).split(25_000);
